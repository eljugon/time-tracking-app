{
  "name": "rail-time-tracking",
  "productName": "Rail",
  "version": "1.0.0",
  "description": "Registro de jornada con sincronización al Excel de OneDrive",
  "author": "Alvaro",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rail.timetracking",
    "productName": "Rail",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  }
}
